# --- LLM configuration (Vercel AI Gateway) -----------------------------------
# HexAgent talks to the Vercel AI Gateway via its OpenAI-compatible Chat
# Completions API. Paste your gateway key below; leave it empty to run fully
# offline in deterministic MOCK mode.
#
# Get a key at: https://vercel.com/docs/ai-gateway

# Vercel AI Gateway API key (preferred). OPENAI_API_KEY is also accepted.
AI_GATEWAY_API_KEY=
# OpenAI-compatible base URL for the gateway (override for other hosts).
OPENAI_BASE_URL=https://ai-gateway.vercel.sh/v1
# Model id in `provider/model` format, e.g. openai/gpt-4o-mini,
# anthropic/claude-sonnet-4.6, openai/gpt-5.5.
HEXAGENT_MODEL=openai/gpt-4o-mini
HEXAGENT_TEMPERATURE=0.1

# --- Agent behaviour ---------------------------------------------------------
# Force deterministic mock mode even if an API key is present (true/false).
HEXAGENT_MOCK_MODE=false
# Register the real nmap_scan tool (shells out to a local nmap binary). Only
# enable this against hosts you are explicitly authorised to test.
HEXAGENT_ENABLE_NMAP=false
# Maximum planner/executor iterations before the graph halts.
HEXAGENT_MAX_ITERATIONS=12
# Require a human approval checkpoint before the final report (true/false).
HEXAGENT_REQUIRE_HUMAN_APPROVAL=false
# Pause and ask before running any tool marked sensitive (e.g. http_post,
# nmap_scan), instead of only reviewing at the end (true/false). With no
# approval callback wired (e.g. non-interactive/programmatic use), sensitive
# actions are denied by default (fail-closed).
HEXAGENT_REQUIRE_SENSITIVE_APPROVAL=false

# --- Browser / Playwright ----------------------------------------------------
# Enable real Playwright browser tools (requires playwright install).
# Install: pip install playwright && playwright install chromium
HEXAGENT_ENABLE_PLAYWRIGHT=false
# Run browser headless (no visible window). Set false for debugging.
PLAYWRIGHT_HEADLESS=true
# Page load / action timeout in milliseconds.
PLAYWRIGHT_TIMEOUT_MS=15000
# Maximum number of network requests captured per browser session.
PLAYWRIGHT_MAX_REQUESTS=200
# Maximum bytes of request/response body preview stored per request.
PLAYWRIGHT_MAX_BODY_PREVIEW_BYTES=2000

# --- Logging -----------------------------------------------------------------
HEXAGENT_LOG_LEVEL=INFO

# --- Output ------------------------------------------------------------------
HEXAGENT_REPORT_DIR=reports
